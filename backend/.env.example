# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_NAME=voltex-backend
APP_VERSION=0.1.0

# Database
DATABASE_URL=postgresql+psycopg://voltex:voltex@localhost:5432/voltex
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

# JWT
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ISSUER=voltex-backend
JWT_AUDIENCE=voltex-mobile
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14

# Passwords
PASSWORD_HASH_ROUNDS=12

# Storage
STORAGE_BACKEND=local_disk
STORAGE_LOCAL_ROOT=./storage
# When STORAGE_BACKEND=s3
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=
STORAGE_S3_ENDPOINT=
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=

# CORS (comma-separated origins, empty disables)
CORS_ORIGINS=

# Idempotency
IDEMPOTENCY_TTL_HOURS=24